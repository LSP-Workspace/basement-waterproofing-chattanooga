---
const currentYear = new Date().getFullYear();
---
<footer class="bg-[#132043] text-white">
  <div class="max-w-7xl mx-auto px-4 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Column 1: Company Info -->
      <div>
        <h3 class="font-bold text-lg mb-4">Basement Waterproofing Chattanooga</h3>
        <p class="text-white/70 text-sm leading-relaxed mb-4">
          Protecting Chattanooga homes from water damage since 2010. Licensed, insured, and backed by a 100% satisfaction guarantee.
        </p>
        <p class="text-white/70 text-sm">
          <span class="block font-semibold text-white mb-1">Phone</span>
          <a href="tel:8653702211" class="hover:text-[#2563eb] transition-colors">(865) 370-2211</a>
        </p>
        <p class="text-white/70 text-sm mt-3">
          <span class="block font-semibold text-white mb-1">Location</span>
          Chattanooga, TN
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="font-bold text-lg mb-4">Quick Links</h3>
        <nav class="flex flex-col gap-2">
          <a href="/" class="text-white/70 hover:text-white text-sm transition-colors">Home</a>
          <a href="/services/basement-waterproofing/" class="text-white/70 hover:text-white text-sm transition-colors">Services</a>
          <a href="/about/" class="text-white/70 hover:text-white text-sm transition-colors">About</a>
          <a href="/#contact" class="text-white/70 hover:text-white text-sm transition-colors">Contact</a>
          <a href="/#contact" class="text-white/70 hover:text-white text-sm transition-colors">Get a Free Quote</a>
        </nav>
      </div>

      <!-- Column 3: Services -->
      <div>
        <h3 class="font-bold text-lg mb-4">Our Services</h3>
        <nav class="flex flex-col gap-2">
          <a href="/services/basement-waterproofing/" class="text-white/70 hover:text-white text-sm transition-colors">Basement Waterproofing</a>
          <a href="/services/crawl-space-waterproofing/" class="text-white/70 hover:text-white text-sm transition-colors">Crawl Space Waterproofing</a>
          <a href="/services/mold-remediation/" class="text-white/70 hover:text-white text-sm transition-colors">Mold Remediation</a>
          <a href="/services/foundation-repair/" class="text-white/70 hover:text-white text-sm transition-colors">Foundation Repair</a>
        </nav>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col md:flex-row items-center justify-between gap-3 text-white/50 text-xs">
      <p>&copy; {currentYear} Basement Waterproofing Chattanooga. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms-and-conditions/" class="hover:text-white transition-colors">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>
