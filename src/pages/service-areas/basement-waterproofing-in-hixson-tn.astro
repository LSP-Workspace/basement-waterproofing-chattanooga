              <button type="submit" id="form-submit" class="w-full bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold py-4 rounded-lg transition-colors active:scale-[0.98] text-base">Request My Free Estimate</button>
              <p class="text-gray-400 text-xs text-center">No spam. No obligation. We respect your privacy.</p>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>
