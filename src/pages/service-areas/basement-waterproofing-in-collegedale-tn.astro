          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow group">
            <div class="h-52 overflow-hidden">
              <img src="/images/hero-foundation-repair.webp" alt="Foundation repair in Collegedale TN" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-[#132043] mb-3"><a href="/foundation-repair/" class="hover:text-[#2563eb] transition-colors">Foundation Repair</a></h3>
              <p class="text-gray-600 leading-relaxed mb-5">Crack injection, wall stabilization, and structural repair for Collegedale homes dealing with settling, bowing walls, or concrete deterioration.</p>
              <a href="/foundation-repair/" class="text-[#2563eb] font-semibold hover:underline text-sm">Learn More &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[#132043] tracking-tighter mb-8">Why Collegedale Homeowners Choose Us</h2>
            <div class="flex flex-col gap-6">
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-[#132043] text-lg mb-1">15+ Years of Local Experience</h3>
                  <p class="text-gray-600 leading-relaxed">We know the soils, drainage patterns, and foundation types common to Collegedale's growing neighborhoods. That context shapes every recommendation we make.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-[#132043] text-lg mb-1">Honest Assessments, Not Upsells</h3>
                  <p class="text-gray-600 leading-relaxed">We tell you exactly what's wrong and what will fix it — nothing more. Transparent pricing with no hidden fees.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-[#132043] text-lg mb-1">Work That Holds Up</h3>
                  <p class="text-gray-600 leading-relaxed">Every project is backed by our 100% satisfaction guarantee. If moisture returns to a treated area, we come back and fix it.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-[#132043] text-lg mb-1">Minimal Disruption</h3>
                  <p class="text-gray-600 leading-relaxed">Most jobs are completed in 1–3 days. We work cleanly and efficiently so your home stays livable throughout the project.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <img src="/images/team-mike-thompson.webp" alt="Basement Waterproofing Chattanooga team" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Neighborhoods -->
    <section class="bg-gray-50 py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="mb-12 text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-[#132043] tracking-tighter mb-4">Serving All of Collegedale</h2>
          <p class="text-gray-600 text-lg max-w-[55ch] mx-auto leading-relaxed">
            From the university district to the subdivisions along Apison Pike, we serve all of Collegedale and nearby communities.
          </p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {["Collegedale Core", "Apison Pike Corridor", "Southern Adventist Area", "Ooltewah Corridor", "Lee Highway Corridor", "Avondale Estates", "Collegedale Commons", "Chester Frost Area"].map(n => (
            <div class="bg-white rounded-xl px-4 py-3 border border-gray-100 text-center">
              <p class="text-[#132043] font-medium text-sm">{n}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white py-20">
      <div class="max-w-3xl mx-auto px-4">
        <div class="mb-12 text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-[#132043] tracking-tighter mb-4">Collegedale FAQ</h2>
        </div>
        <div class="flex flex-col gap-4">
          <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-semibold text-[#132043] hover:bg-gray-50 transition-colors list-none">
              Why do newer Collegedale homes still get water in the basement?
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-600 leading-relaxed border-t border-gray-100">
              New construction doesn't automatically mean dry basements. Collegedale's clay-heavy soils in the Ooltewah corridor expand when wet and push water toward foundation walls regardless of how recently the home was built. As backfill around the foundation settles over the first few years, drainage grades can shift and direct water toward the structure. Builder-applied waterproofing also varies widely in quality. We often see newer homes that need drainage upgrades within their first decade.
            </div>
          </details>
          <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-semibold text-[#132043] hover:bg-gray-50 transition-colors list-none">
              Do you serve Collegedale and nearby Ooltewah?
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-600 leading-relaxed border-t border-gray-100">
              Yes. We serve all of Collegedale, Ooltewah, and the broader Hamilton County area. Our trucks are in this corridor regularly — scheduling a free consultation is quick, usually within 1–2 business days.
            </div>
          </details>
          <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-semibold text-[#132043] hover:bg-gray-50 transition-colors list-none">
              What's the most common waterproofing issue in Collegedale?
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-600 leading-relaxed border-t border-gray-100">
              The most common issue we see in Collegedale is hydrostatic pressure from clay soil combined with inadequate or failed perimeter drainage. Water saturates the clay, which swells and pushes against the foundation walls. Interior French drain systems paired with a properly sized sump pump are typically the right long-term fix for this type of problem.
            </div>
          </details>
          <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-semibold text-[#132043] hover:bg-gray-50 transition-colors list-none">
              Do you offer free consultations in Collegedale?
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-600 leading-relaxed border-t border-gray-100">
              Absolutely. Every job starts with a free, no-obligation on-site consultation. We assess your specific situation, walk you through what we're seeing, and provide a detailed estimate. No pressure, no sales pitch — just an honest evaluation of the problem and what it will take to solve it.
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="bg-[#132043] py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
          <div class="pt-2">
            <h2 class="text-4xl md:text-5xl font-bold text-white tracking-tighter mb-6">Get Your Free Estimate</h2>
            <p class="text-white/70 text-lg leading-relaxed mb-8">Ready to solve your water problem for good? Fill out the form and we'll be in touch within one business day. No obligation, no pressure.</p>
            <div class="flex flex-col gap-4">
              <div class="flex items-center gap-3"><div class="w-5 h-5 bg-[#2563eb] rounded-full flex-shrink-0 flex items-center justify-center"><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></div><span class="text-white/80">Free, no-obligation consultations</span></div>
              <div class="flex items-center gap-3"><div class="w-5 h-5 bg-[#2563eb] rounded-full flex-shrink-0 flex items-center justify-center"><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></div><span class="text-white/80">Transparent pricing, no hidden fees</span></div>
              <div class="flex items-center gap-3"><div class="w-5 h-5 bg-[#2563eb] rounded-full flex-shrink-0 flex items-center justify-center"><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></div><span class="text-white/80">100% satisfaction guaranteed</span></div>
              <div class="flex items-center gap-3"><div class="w-5 h-5 bg-[#2563eb] rounded-full flex-shrink-0 flex items-center justify-center"><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></div><span class="text-white/80">Serving Collegedale &amp; surrounding areas</span></div>
            </div>
            <div class="mt-10 pt-8 border-t border-white/20">
