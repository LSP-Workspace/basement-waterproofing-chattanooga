---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
  "name": "Basement Waterproofing Chattanooga",
  "serviceType": "Basement Waterproofing",
  "telephone": "+18653702211",
  "url": "https://basementwaterproofingchattanooga.com/service-areas/basement-waterproofing-in-collegedale-tn/",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Collegedale",
    "addressRegion": "TN",
    "addressCountry": "US"
  },
  "areaServed": { "@type": "City", "name": "Collegedale", "addressRegion": "TN" }
