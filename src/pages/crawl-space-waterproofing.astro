---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Service"],
  "name": "Basement Waterproofing Chattanooga",
  "serviceType": "Crawl Space Waterproofing",
  "telephone": "+18653702211",
  "url": "https://basementwaterproofingchattanooga.com/crawl-space-waterproofing/",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "812 E 12th St #225",
    "addressLocality": "Chattanooga",
    "addressRegion": "TN",
    "postalCode": "37403",
    "addressCountry": "US"
  },
  "areaServed": { "@type": "City", "name": "Chattanooga", "addressRegion": "TN" }
};
---
<BaseLayout
  title="Crawl Space Waterproofing in Chattanooga, TN | Basement Waterproofing Chattanooga"
  description="Professional crawl space waterproofing and encapsulation in Chattanooga, TN. Vapor barriers, drainage systems, dehumidifiers. Free estimates. Call (865) 370-2211."
  schema={schema}
>
  <Header />
  <main id="main-content">

    <!-- Page Hero -->
    <section
      class="relative min-h-[60dvh] flex items-center"
      style="background-image: url('/images/hero-crawl-space.webp'); background-size: cover; background-position: top;"
    >
      <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.50), rgba(0,0,0,0.25));"></div>
      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 py-16 flex justify-center">
        <div class="max-w-3xl w-full text-center">
          <p class="text-white/90 text-base font-semibold uppercase tracking-widest mb-4" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.65);">Professional Crawl Space Services in Chattanooga</p>
          <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tighter leading-tight mb-6" style="text-shadow: 1px 1px 4px rgba(0,0,0,0.75);">Crawl Space Waterproofing in Chattanooga, TN</h1>
          <p class="text-white/75 text-lg leading-relaxed mb-8 max-w-[55ch] mx-auto" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.65);">Eliminate moisture, mold, and structural risk beneath your home with full crawl space encapsulation and drainage solutions.</p>
          <a href="#contact" class="inline-block bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold px-8 py-4 rounded-lg transition-colors active:scale-[0.98]">Get a Free Estimate</a>
        </div>
      </div>
    </section>

    <!-- Intro Section -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[#132043] tracking-tighter mb-6">Why Crawl Space Waterproofing Is Essential</h2>
            <p class="text-gray-600 text-lg leading-relaxed mb-4">
              Moisture problems in crawl spaces can lead to serious issues like mold growth, structural damage, and poor indoor air quality. Because air from the crawl space circulates throughout your home, what happens below affects everything above.
            </p>
            <p class="text-gray-600 text-lg leading-relaxed">
              Our expert team delivers comprehensive crawl space waterproofing solutions designed to protect your home's foundation and the air your family breathes.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#132043] mb-5">Signs You Need Crawl Space Waterproofing</h3>
            <div class="flex flex-col gap-4">
              <div class="flex gap-4 items-start">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#132043]">Damp or Musty Odors</p>
                  <p class="text-gray-600 text-sm leading-relaxed">Persistent smells rising into your living space indicate active moisture in the crawl area.</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#132043]">Visible Mold or Mildew</p>
                  <p class="text-gray-600 text-sm leading-relaxed">Any sign of mold should be addressed immediately — mold spreads fast in enclosed, humid spaces.</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#132043]">Standing Water or Puddles</p>
                  <p class="text-gray-600 text-sm leading-relaxed">Water accumulation is a clear sign of a drainage or waterproofing failure beneath your home.</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#132043]">Sagging Floors Above</p>
                  <p class="text-gray-600 text-sm leading-relaxed">Moisture causes wood rot and structural damage, leading to uneven floors throughout your home.</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#132043]">Increased Allergy Symptoms</p>
                  <p class="text-gray-600 text-sm leading-relaxed">Poor air quality from mold and moisture circulating up from the crawl space can exacerbate respiratory issues and allergies.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Process -->
    <section class="bg-gray-50 py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="mb-12 text-center">
          <h2 class="text-4xl md:text-5xl font-bold text-[#132043] tracking-tighter mb-4">Our Crawl Space Waterproofing Process</h2>
          <p class="text-gray-600 text-lg max-w-[55ch] mx-auto leading-relaxed">A comprehensive, step-by-step approach that addresses moisture at every entry point — not just the symptoms.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
            <div class="text-[#2563eb] font-bold text-3xl mb-4">01</div>
            <h3 class="font-bold text-[#132043] text-lg mb-3">Inspection &amp; Assessment</h3>
            <p class="text-gray-600 leading-relaxed">Our team conducts a thorough inspection to identify moisture sources and assess the condition of your crawl space. You get a detailed report and clear recommendations before any work begins.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
            <div class="text-[#2563eb] font-bold text-3xl mb-4">02</div>
            <h3 class="font-bold text-[#132043] text-lg mb-3">Moisture Barrier Installation</h3>
            <p class="text-gray-600 leading-relaxed">We install high-quality vapor barriers to prevent moisture from seeping into your crawl space. These barriers are designed to last, providing long-term protection against water intrusion.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
            <div class="text-[#2563eb] font-bold text-3xl mb-4">03</div>
            <h3 class="font-bold text-[#132043] text-lg mb-3">Drainage Solutions</h3>
            <p class="text-gray-600 leading-relaxed">Effective drainage is key to keeping your crawl space dry. We install perimeter drains and sump pump systems to manage water and direct it away from your home's foundation.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
            <div class="text-[#2563eb] font-bold text-3xl mb-4">04</div>
            <h3 class="font-bold text-[#132043] text-lg mb-3">Dehumidification</h3>
            <p class="text-gray-600 leading-relaxed">To control humidity levels, we install state-of-the-art dehumidifiers that work efficiently to keep your crawl space dry and mold-free year-round, even in Tennessee's humid summers.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost Section -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[#132043] tracking-tighter mb-6">What Does Crawl Space Waterproofing Cost?</h2>
            <p class="text-gray-600 text-lg leading-relaxed mb-4">
              The cost of waterproofing your crawl space varies based on several factors, including the size of your crawl space and the extent of moisture issues. On average, homeowners invest between <strong class="text-[#132043]">$1,500 and $15,000</strong> for a complete waterproofing system.
            </p>
            <p class="text-gray-600 text-lg leading-relaxed mb-6">
              We provide free, detailed estimates so you know exactly what to expect — no guesswork, no surprise invoices after the work is done.
            </p>
            <a href="#contact" class="inline-block bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold px-8 py-4 rounded-lg transition-colors active:scale-[0.98]">
              Get a Free Estimate
            </a>
          </div>
          <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
            <h3 class="font-bold text-[#132043] text-xl mb-6">Factors That Affect Cost</h3>
            <div class="flex flex-col gap-4">
              <div class="flex gap-3 items-center border-b border-gray-200 pb-4">
                <div class="w-2 h-2 bg-[#2563eb] rounded-full flex-shrink-0"></div>
                <p class="text-gray-600">Size of the crawl space</p>
              </div>
              <div class="flex gap-3 items-center border-b border-gray-200 pb-4">
                <div class="w-2 h-2 bg-[#2563eb] rounded-full flex-shrink-0"></div>
                <p class="text-gray-600">Severity of existing moisture intrusion</p>
              </div>
              <div class="flex gap-3 items-center border-b border-gray-200 pb-4">
                <div class="w-2 h-2 bg-[#2563eb] rounded-full flex-shrink-0"></div>
                <p class="text-gray-600">Whether mold remediation is also needed</p>
              </div>
              <div class="flex gap-3 items-center border-b border-gray-200 pb-4">
                <div class="w-2 h-2 bg-[#2563eb] rounded-full flex-shrink-0"></div>
                <p class="text-gray-600">Type of vapor barrier and drainage system selected</p>
              </div>
              <div class="flex gap-3 items-center">
                <div class="w-2 h-2 bg-[#2563eb] rounded-full flex-shrink-0"></div>
                <p class="text-gray-600">Sump pump installation and dehumidifier requirements</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us Strip -->
    <section class="bg-[#132043] py-20">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tighter mb-10 text-center">Why Chattanooga Homeowners Choose Us</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-white text-lg mb-1">15+ Years of Local Experience</h3>
              <p class="text-white/70 leading-relaxed">We've worked on hundreds of Chattanooga homes and understand the region's soil, water table, and seasonal patterns that drive moisture problems.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-white text-lg mb-1">Precision Diagnostics, Not Guesswork</h3>
              <p class="text-white/70 leading-relaxed">Every job starts with a thorough inspection. We identify the root cause before recommending any work — and we only recommend what you actually need.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-white text-lg mb-1">Transparent Pricing, No Surprises</h3>
              <p class="text-white/70 leading-relaxed">You get a detailed written estimate before work begins. No hidden fees, no upsells, no pressure — just honest work at a fair price.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-white text-lg mb-1">100% Satisfaction Guarantee</h3>
              <p class="text-white/70 leading-relaxed">We stand behind every job. If the problem returns, so do we — at no additional cost.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-20" style="background-color: #0d1730;">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

          <div class="pt-2">
            <h2 class="text-4xl md:text-5xl font-bold text-white tracking-tighter mb-6">Get Your Free Estimate</h2>
            <p class="text-white/70 text-lg leading-relaxed mb-8">
              Ready to solve your water problem for good? Fill out the form and we'll be in touch within one business day. No obligation, no pressure.
            </p>
            <div class="flex flex-col gap-4">
              <div class="flex items-center gap-3">
                <div class="w-5 h-5 bg-[#2563eb] rounded-full flex-shrink-0 flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-white/80">Free, no-obligation consultations</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-5 h-5 bg-[#2563eb] rounded-full flex-shrink-0 flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-white/80">Transparent pricing, no hidden fees</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-5 h-5 bg-[#2563eb] rounded-full flex-shrink-0 flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-white/80">100% satisfaction guaranteed</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-5 h-5 bg-[#2563eb] rounded-full flex-shrink-0 flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-white/80">Serving all of Chattanooga &amp; surrounding areas</span>
              </div>
            </div>
            <div class="mt-10 pt-8 border-t border-white/20">
              <p class="text-white/50 text-sm mb-2">Prefer to call?</p>
              <a href="tel:8653702211" class="text-white font-bold text-2xl hover:text-[#93c5fd] transition-colors">(865) 370-2211</a>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-8 shadow-xl">
            <h3 class="text-xl font-bold text-[#132043] mb-6">Tell Us About Your Project</h3>
            <form id="contact-form" class="flex flex-col gap-5" novalidate>
              <input type="text" name="_hp" class="hidden" tabindex="-1" autocomplete="off" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="firstName" class="block text-sm font-semibold text-[#132043] mb-1.5">First Name <span class="text-red-500">*</span></label>
                  <input type="text" id="firstName" name="firstName" required
                    class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#2563eb] focus:border-transparent transition"
                    placeholder="Mike" />
                </div>
                <div>
                  <label for="lastName" class="block text-sm font-semibold text-[#132043] mb-1.5">Last Name <span class="text-red-500">*</span></label>
                  <input type="text" id="lastName" name="lastName" required
                    class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#2563eb] focus:border-transparent transition"
                    placeholder="Thompson" />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-semibold text-[#132043] mb-1.5">Email <span class="text-red-500">*</span></label>
                <input type="email" id="email" name="email" required
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#2563eb] focus:border-transparent transition"
                  placeholder="mike@example.com" />
              </div>

              <div>
                <label for="phone" class="block text-sm font-semibold text-[#132043] mb-1.5">Phone <span class="text-red-500">*</span></label>
                <input type="tel" id="phone" name="phone" required
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#2563eb] focus:border-transparent transition"
                  placeholder="(865) 555-0123" />
              </div>

              <div>
                <label for="message" class="block text-sm font-semibold text-[#132043] mb-1.5">Tell Us About Your Project</label>
                <textarea id="message" name="message" rows="4"
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#2563eb] focus:border-transparent transition resize-none"
                  placeholder="Describe the issue — damp basement, crawl space moisture, cracks in foundation..."></textarea>
              </div>

              <div class="cf-turnstile" data-sitekey="0x4AAAAAADLoAKoG-gOkkr1j" data-appearance="interaction-only"></div>

              <div id="form-success" class="hidden bg-green-50 border border-green-200 text-green-800 rounded-lg px-4 py-3 text-sm font-medium">
                ✓ Thanks! We'll be in touch within one business day.
              </div>
              <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm">
                Something went wrong. Please call us at (865) 370-2211.
              </div>

              <button type="submit" id="form-submit"
                class="w-full bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold py-4 rounded-lg transition-colors active:scale-[0.98] text-base">
                Request My Free Estimate
              </button>

              <p class="text-gray-400 text-xs text-center">No spam. No obligation. We respect your privacy.</p>
            </form>
          </div>

        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      var submitBtn = document.getElementById('form-submit');
      var successMsg = document.getElementById('form-success');
      var errorMsg = document.getElementById('form-error');

      if (!form) return;

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        successMsg.classList.add('hidden');
        errorMsg.classList.add('hidden');

        var turnstileToken = form.querySelector('[name="cf-turnstile-response"]')?.value || '';

        var payload = {
          firstName: form.querySelector('#firstName')?.value || '',
          lastName: form.querySelector('#lastName')?.value || '',
          email: form.querySelector('#email')?.value || '',
          phone: form.querySelector('#phone')?.value || '',
          message: form.querySelector('#message')?.value || '',
          _hp: form.querySelector('[name="_hp"]')?.value || '',
          turnstileToken: turnstileToken,
        };

        try {
          var res = await fetch('/api/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          var result = await res.json();
          if (result.status === 'success') {
            successMsg.classList.remove('hidden');
            form.reset();
            if (window.turnstile) window.turnstile.reset();
          } else {
            errorMsg.classList.remove('hidden');
            if (window.turnstile) window.turnstile.reset();
          }
        } catch (err) {
          errorMsg.classList.remove('hidden');
          if (window.turnstile) window.turnstile.reset();
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Request My Free Estimate';
        }
      });
    })();
  </script>
</BaseLayout>
