---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Terms and Conditions | Basement Waterproofing Chattanooga"
  description="Terms and conditions for Basement Waterproofing Chattanooga."
>
  <Header />
  <main class="bg-gray-50 min-h-[60vh]">
    <div class="max-w-3xl mx-auto px-4 py-20">
      <h1 class="text-4xl font-bold text-[#132043] tracking-tighter mb-6">Terms &amp; Conditions</h1>
      <div class="bg-white rounded-2xl border border-gray-200 p-10 text-gray-600 leading-relaxed">
        <p class="text-lg mb-6">This page is under construction.</p>
        <p>Our full terms and conditions will be published here shortly. For any questions, please call us at <a href="tel:8653702211" class="text-[#2563eb] hover:underline">(865) 370-2211</a>.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
