---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Basement Waterproofing Chattanooga",
  "telephone": "+18653702211",
  "url": "https://basementwaterproofingchattanooga.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "812 E 12th St #225",
    "addressLocality": "Chattanooga",
    "addressRegion": "TN",
    "postalCode": "37403",
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "City",
    "name": "Chattanooga",
    "addressRegion": "TN"
  },
  "description": "Chattanooga's most trusted basement waterproofing experts. Protecting homes from water damage since 2010.",
  "foundingDate": "2010",
  "priceRange": "$$"
};
---
<BaseLayout
  title="Basement Waterproofing Chattanooga | Trusted Local Experts Since 2010"
  description="Chattanooga's most trusted basement waterproofing company. We offer basement waterproofing, crawl space waterproofing, mold remediation, and foundation repair. Free consultations. Call (865) 370-2211."
  schema={localBusinessSchema}
>
  <Header />
  <main id="main-content">
    <!-- Hero Section -->
    <section
      class="relative min-h-[70dvh] flex items-center bg-[#132043] [background-position:right_top] md:[background-position:top]"
      style="background-image: url('/images/hero-home.webp'); background-size: cover;"
    >
      <!-- Dark overlay so text reads clearly -->
      <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.40), rgba(0,0,0,0.20));"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 py-16 w-full">
        <div class="max-w-2xl">
          <p class="text-white/90 text-base font-semibold uppercase tracking-widest mb-4" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.65);">Trusted Waterproofing Solutions in Tennessee</p>
          <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tighter leading-none mb-6" style="text-shadow: 1px 1px 4px rgba(0,0,0,0.75);">
            Basement Waterproofing in Chattanooga
          </h1>
          <p class="text-white/75 text-lg leading-relaxed mb-8 max-w-[55ch]" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.65);">
            Protecting homes from water damage since 2010. Free consultations. Guaranteed results.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#contact" class="bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold px-8 py-4 rounded-lg text-center transition-colors active:scale-[0.98]">
              Get a Free Estimate
            </a>
            <a href="tel:8653702211" class="border border-white/70 bg-[#132043]/40 hover:bg-transparent hover:border-white text-white font-semibold px-8 py-4 rounded-lg text-center transition-colors">
              (865) 370-2211
            </a>

          </div>
        </div>
      </div>
    </section>

    <!-- Trust Bar -->
    <section class="bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 py-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="flex flex-col items-center text-center gap-2">
            <div class="w-12 h-12 bg-[#2563eb]/10 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-[#2563eb]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <p class="font-bold text-[#132043] text-lg">Founded 2010</p>
            <p class="text-gray-500 text-sm">15+ years experience</p>
          </div>
          <div class="flex flex-col items-center text-center gap-2">
            <div class="w-12 h-12 bg-[#2563eb]/10 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-[#2563eb]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="font-bold text-[#132043] text-lg">100% Guarantee</p>
            <p class="text-gray-500 text-sm">Satisfaction guaranteed</p>
          </div>
          <div class="flex flex-col items-center text-center gap-2">
            <div class="w-12 h-12 bg-[#2563eb]/10 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-[#2563eb]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <p class="font-bold text-[#132043] text-lg">Chattanooga, TN</p>
            <p class="text-gray-500 text-sm">Locally based &amp; owned</p>
          </div>
          <div class="flex flex-col items-center text-center gap-2">
            <div class="w-12 h-12 bg-[#2563eb]/10 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-[#2563eb]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <p class="font-bold text-[#132043] text-lg">Free Consultations</p>
            <p class="text-gray-500 text-sm">No obligation estimates</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Welcome Section -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl md:text-5xl font-bold text-[#132043] tracking-tighter mb-6">Welcome to Basement Waterproofing Chattanooga</h2>
            <p class="text-gray-600 text-lg leading-relaxed mb-4">
              Founded in 2010 by Chattanooga native Mike Thompson, Basement Waterproofing Chattanooga was born out of a passion for protecting homes from the unpredictable weather in Tennessee. After experiencing water damage in his own basement, Mike realized the pressing need for reliable waterproofing services in the area.
            </p>
            <p class="text-gray-600 text-lg leading-relaxed">
              Our mission is simple: to ensure every home in Chattanooga remains safe, dry, and structurally sound, so families can enjoy their homes without worry.
            </p>
          </div>
          <div class="grid grid-cols-1 gap-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-[#132043] text-lg mb-2">Local Expertise</h3>
              <p class="text-gray-600 leading-relaxed">Our deep roots in Chattanooga drive us to provide top-notch service. We understand the unique challenges posed by the local climate and terrain, and our team is dedicated to offering solutions tailored to each client's needs.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-[#132043] text-lg mb-2">Comprehensive Services</h3>
              <p class="text-gray-600 leading-relaxed">From basement and crawl space waterproofing to mold remediation and foundation repair, we offer a full suite of services to protect your home.</p>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="font-bold text-[#132043] text-lg mb-2">Community Commitment</h3>
              <p class="text-gray-600 leading-relaxed">Our commitment to the Chattanooga area is unwavering. We strive to contribute positively to our community by ensuring the longevity and safety of its homes.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="bg-gray-50 py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="mb-12 text-center">
          <h2 class="text-4xl md:text-5xl font-bold text-[#132043] tracking-tighter mb-4">Our Services</h2>
          <p class="text-gray-600 text-lg max-w-[55ch] mx-auto leading-relaxed">
            Comprehensive water damage solutions for Chattanooga homeowners — from basement to foundation.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Basement Waterproofing -->
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow group">
            <div class="h-52 overflow-hidden">
              <img
                src="/images/hero-basement-waterproofing.webp"
                alt="Basement waterproofing services in Chattanooga"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-[#132043] mb-3"><a href="/basement-waterproofing/" class="hover:text-[#2563eb] transition-colors">Basement Waterproofing</a></h3>
              <p class="text-gray-600 leading-relaxed mb-5">Interior and exterior waterproofing systems that keep your basement permanently dry, protecting your home's structure and living space.</p>
              <a href="/basement-waterproofing/" class="text-[#2563eb] font-semibold hover:underline text-sm">Learn More &rarr;</a>
            </div>
          </div>

          <!-- Crawl Space Waterproofing -->
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow group">
            <div class="h-52 overflow-hidden">
              <img
                src="/images/hero-crawl-space.webp"
                alt="Crawl space waterproofing services in Chattanooga"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-[#132043] mb-3"><a href="/crawl-space-waterproofing/" class="hover:text-[#2563eb] transition-colors">Crawl Space Waterproofing</a></h3>
              <p class="text-gray-600 leading-relaxed mb-5">Full crawl space encapsulation and vapor barrier installation to eliminate moisture, mold, and structural deterioration beneath your home.</p>
              <a href="/crawl-space-waterproofing/" class="text-[#2563eb] font-semibold hover:underline text-sm">Learn More &rarr;</a>
            </div>
          </div>

          <!-- Mold Remediation -->
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow group">
            <div class="h-52 overflow-hidden">
              <img
                src="/images/hero-mold-remediation.webp"
                alt="Mold remediation services in Chattanooga"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-[#132043] mb-3"><a href="/mold-remediation/" class="hover:text-[#2563eb] transition-colors">Mold Remediation</a></h3>
              <p class="text-gray-600 leading-relaxed mb-5">Safe, thorough mold removal and prevention treatments that restore air quality and protect your family's health from the ground up.</p>
              <a href="/mold-remediation/" class="text-[#2563eb] font-semibold hover:underline text-sm">Learn More &rarr;</a>
            </div>
          </div>

          <!-- Foundation Repair -->
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow group">
            <div class="h-52 overflow-hidden">
              <img
                src="/images/hero-foundation-repair.webp"
                alt="Foundation repair services in Chattanooga"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-[#132043] mb-3"><a href="/foundation-repair/" class="hover:text-[#2563eb] transition-colors">Foundation Repair</a></h3>
              <p class="text-gray-600 leading-relaxed mb-5">Expert diagnosis and repair of cracked, bowing, or settling foundations using proven stabilization methods built to last.</p>
              <a href="/foundation-repair/" class="text-[#2563eb] font-semibold hover:underline text-sm">Learn More &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Meet Our Team -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="mb-12 text-center">
          <h2 class="text-4xl md:text-5xl font-bold text-[#132043] tracking-tighter mb-4">Meet Our Team</h2>
          <p class="text-gray-600 text-lg max-w-[55ch] mx-auto leading-relaxed">
            A dedicated local team with the experience and commitment to protect your home.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
            <h3 class="font-bold text-[#132043] text-lg mb-1">Mike Thompson</h3>
            <p class="text-[#2563eb] font-semibold text-sm mb-3">Founder &amp; CEO</p>
            <p class="text-gray-600 text-sm leading-relaxed">A Chattanooga native, Mike is passionate about home safety and community service. With over 15 years of experience in the waterproofing industry, he leads our team with dedication and a personal touch.</p>
          </div>
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
            <h3 class="font-bold text-[#132043] text-lg mb-1">Sarah Johnson</h3>
            <p class="text-[#2563eb] font-semibold text-sm mb-3">Operations Manager</p>
            <p class="text-gray-600 text-sm leading-relaxed">Born and raised in Chattanooga, Sarah brings a wealth of local knowledge and organizational expertise to the team. Her focus is on ensuring seamless service delivery and customer satisfaction.</p>
          </div>
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
            <h3 class="font-bold text-[#132043] text-lg mb-1">James Carter</h3>
            <p class="text-[#2563eb] font-semibold text-sm mb-3">Lead Technician</p>
            <p class="text-gray-600 text-sm leading-relaxed">A certified waterproofing specialist, James has been with us for over a decade. His meticulous attention to detail and commitment to excellence make him an invaluable asset to our team.</p>
          </div>
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
            <h3 class="font-bold text-[#132043] text-lg mb-1">Emily Davis</h3>
            <p class="text-[#2563eb] font-semibold text-sm mb-3">Customer Relations Specialist</p>
            <p class="text-gray-600 text-sm leading-relaxed">Emily is the friendly voice our customers hear when they call. She is dedicated to understanding and addressing the unique needs of each client, ensuring a positive experience from start to finish.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Where We Serve -->
    <section class="bg-[#132043] py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl md:text-5xl font-bold text-white tracking-tighter mb-6">Where We Serve</h2>
            <p class="text-white/75 text-lg leading-relaxed mb-6">
              Basement Waterproofing Chattanooga proudly serves the entire Chattanooga region, from bustling downtown districts to quieter suburban areas. Whether it's a private home or a commercial property, our team ensures that clients across the area benefit from top-quality waterproofing solutions.
            </p>
            <a href="#contact" class="inline-block bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold px-8 py-4 rounded-lg transition-colors active:scale-[0.98]">
              Get a Free Estimate
            </a>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-white/10 rounded-xl p-5 border border-white/20">
              <h3 class="text-white font-bold mb-1">Downtown Chattanooga</h3>
              <p class="text-white/60 text-sm">Full residential &amp; commercial coverage</p>
            </div>
            <div class="bg-white/10 rounded-xl p-5 border border-white/20">
              <h3 class="text-white font-bold mb-1">East Brainerd</h3>
              <p class="text-white/60 text-sm">Basement &amp; crawl space specialists</p>
            </div>
            <div class="bg-white/10 rounded-xl p-5 border border-white/20">
              <h3 class="text-white font-bold mb-1">Hixson</h3>
              <p class="text-white/60 text-sm">Foundation repair &amp; waterproofing</p>
            </div>
            <div class="bg-white/10 rounded-xl p-5 border border-white/20">
              <h3 class="text-white font-bold mb-1">Soddy-Daisy</h3>
              <p class="text-white/60 text-sm">Mold remediation &amp; drainage</p>
            </div>
            <div class="bg-white/10 rounded-xl p-5 border border-white/20">
              <h3 class="text-white font-bold mb-1">Red Bank</h3>
              <p class="text-white/60 text-sm">Interior &amp; exterior waterproofing</p>
            </div>
            <div class="bg-white/10 rounded-xl p-5 border border-white/20">
              <h3 class="text-white font-bold mb-1">&amp; Surrounding Areas</h3>
              <p class="text-white/60 text-sm">Call to confirm your area</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl md:text-5xl font-bold text-[#132043] tracking-tighter mb-8">Why Chattanooga Homeowners Choose Us</h2>
            <div class="flex flex-col gap-6">
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-[#132043] text-lg mb-1">15+ Years of Local Experience</h3>
                  <p class="text-gray-600 leading-relaxed">We've worked on hundreds of Chattanooga homes and understand the region's soil, water table, and seasonal patterns that drive moisture problems.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-[#132043] text-lg mb-1">Precision Diagnostics, Not Guesswork</h3>
                  <p class="text-gray-600 leading-relaxed">Every job starts with a thorough inspection. We identify the root cause before recommending any work — and we only recommend what you actually need.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-[#132043] text-lg mb-1">Transparent Pricing, No Surprises</h3>
                  <p class="text-gray-600 leading-relaxed">You get a detailed written estimate before work begins. No hidden fees, no upsells, no pressure — just honest work at a fair price.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 bg-[#2563eb] rounded-full flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-[#132043] text-lg mb-1">100% Satisfaction Guarantee</h3>
                  <p class="text-gray-600 leading-relaxed">We stand behind every job. If the problem returns, so do we — at no additional cost.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <img
              src="/images/team-mike-thompson.webp"
              alt="Mike Thompson, founder of Basement Waterproofing Chattanooga"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-gray-50 py-20">
      <div class="max-w-4xl mx-auto px-4">
        <div class="mb-12 text-center">
          <h2 class="text-4xl md:text-5xl font-bold text-[#132043] tracking-tighter mb-4">Common Questions</h2>
          <p class="text-gray-600 text-lg leading-relaxed">Answers to what Chattanooga homeowners ask us most.</p>
        </div>
        <div class="flex flex-col gap-4">
          <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-semibold text-[#132043] hover:bg-gray-50 transition-colors list-none">
              How do I know if my basement needs waterproofing?
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-600 leading-relaxed border-t border-gray-100">
              Common signs include musty odors, visible mold or mildew, water stains on walls or floors, efflorescence (white mineral deposits), cracks in the foundation, or standing water after rain. If you notice any of these, call us for a free inspection — catching it early prevents far more expensive repairs down the road.
            </div>
          </details>

          <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-semibold text-[#132043] hover:bg-gray-50 transition-colors list-none">
              How long does basement waterproofing take?
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-600 leading-relaxed border-t border-gray-100">
              Most interior waterproofing projects are completed in 1–3 days depending on basement size and the extent of the work. Exterior waterproofing typically takes 2–5 days. We work efficiently and keep disruption to your daily routine to a minimum — you'll know exactly what to expect before we start.
            </div>
          </details>

          <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-semibold text-[#132043] hover:bg-gray-50 transition-colors list-none">
              What's the difference between interior and exterior waterproofing?
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-600 leading-relaxed border-t border-gray-100">
              Interior waterproofing manages water that enters the basement by channeling it to a sump pump system — it's less disruptive and works well for most situations. Exterior waterproofing addresses the source by applying a waterproof membrane to the outside of your foundation walls. We assess each home individually and recommend the approach that solves the actual problem, not just the most expensive option.
            </div>
